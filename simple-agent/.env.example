# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# WhatsApp Business Cloud API Configuration (Optional - falls back to Development Simulator if unset)
# WHATSAPP_CLOUD_API_KEY=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=100000000000001
# WHATSAPP_BUSINESS_ACCOUNT_ID=200000000000001
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=scheme_finder_verify_token

# Autonomous Scheme Monitor Configuration
SCHEME_MONITOR_SCAN_INTERVAL_HOURS=168  # Weekly (7 days * 24 hours)
